{
  "name": "flowvocab",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest",
    "test:run": "vitest run",
    "test:python": "node scripts/run-python-tests.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:release": "node scripts/release_quality_test.mjs && node scripts/pwa-assets-contract.mjs && node --test scripts/service-worker.test.mjs scripts/bundle-size.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:run && npm run test:python && npm run build && npm run check:bundle && npm run check:release && node scripts/validate-content.mjs",
    "lint": "node scripts/lint.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "echarts": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
