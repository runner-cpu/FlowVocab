{
 "s1": [
  {
   "start": 0.1,
   "end": 3.761,
   "text": "背单词最怕三件事：倒计时催命，答错只给答案，"
  },
  {
   "start": 3.761,
   "end": 4.593,
   "text": "断网就停。"
  },
  {
   "start": 4.543,
   "end": 6.726,
   "text": "微光港把这三件事一次改掉。"
  },
  {
   "start": 6.726,
   "end": 8.89,
   "text": "不用注册，断网也能练。"
  }
 ],
 "s2": [
  {
   "start": 0.1,
   "end": 1.869,
   "text": "答错先别急着看答案。"
  },
  {
   "start": 1.819,
   "end": 5.619,
   "text": "系统先判错因：时态、主谓一致、冠词、介词、"
  },
  {
   "start": 5.619,
   "end": 9.963,
   "text": "词义辨析、词形、从句、拼写、听力细节，一共十类。"
  },
  {
   "start": 9.963,
   "end": 12.817,
   "text": "判完给规则，再配一张最接近的形近词卡。"
  },
  {
   "start": 12.817,
   "end": 15.466,
   "text": "错题留在本机，答对自动移出。"
  }
 ],
 "s3": [
  {
   "start": 0.1,
   "end": 1.365,
   "text": "这里没有倒计时。"
  },
  {
   "start": 1.315,
   "end": 4.916,
   "text": "连对攒连击，五连击触发双倍经验，答错清零。"
  },
  {
   "start": 4.916,
   "end": 7.937,
   "text": "一轮结束按正确率给星，星变星尘，"
  },
  {
   "start": 7.937,
   "end": 9.636,
   "text": "星尘灌成星球能量。"
  }
 ],
 "s4": [
  {
   "start": 0.1,
   "end": 2.307,
   "text": "六个站共用一套判分和激励。"
  },
  {
   "start": 2.257,
   "end": 5.992,
   "text": "语法五大分支、十五个节点；句子是拼图和翻译对决；"
  },
  {
   "start": 5.992,
   "end": 9.103,
   "text": "听力有听写和十个生活场景；写作排序改错；"
  },
  {
   "start": 9.103,
   "end": 10.504,
   "text": "阅读三章原创故事。"
  },
  {
   "start": 10.504,
   "end": 14.384,
   "text": "词库五千八百零五词，五千七百二十九条真实例句。"
  }
 ],
 "s5": [
  {
   "start": 0.1,
   "end": 1.673,
   "text": "每次练习都留下痕迹。"
  },
  {
   "start": 1.623,
   "end": 5.191,
   "text": "六维雷达看相对水平；九十天热力图能点到每一天；"
  },
  {
   "start": 5.191,
   "end": 8.293,
   "text": "错题按最近答错排序，点一条直接回到原题。"
  }
 ],
 "s6": [
  {
   "start": 0.1,
   "end": 3.769,
   "text": "整站做了 PWA 离线缓存，预缓存一百一十三项、"
  },
  {
   "start": 3.769,
   "end": 4.686,
   "text": "约三点二兆。"
  },
  {
   "start": 4.636,
   "end": 6.66,
   "text": "断网刷新，照常练习。"
  },
  {
   "start": 6.66,
   "end": 10.336,
   "text": "进度和错题只写在本机，没有账号，没有上传。"
  }
 ],
 "s7": [
  {
   "start": 0.1,
   "end": 1.785,
   "text": "三件事可以当场查。"
  },
  {
   "start": 1.735,
   "end": 3.68,
   "text": "错因归因是纯函数，有单测；"
  },
  {
   "start": 3.68,
   "end": 6.373,
   "text": "正确项按题号确定性重排，防位置连对；"
  },
  {
   "start": 6.373,
   "end": 9.515,
   "text": "发布门禁跑类型检查、五百二十四项前端测试、"
  },
  {
   "start": 9.515,
   "end": 12.208,
   "text": "二十一项内容测试、二十一项契约测试，"
  },
  {
   "start": 12.208,
   "end": 13.256,
   "text": "再加体积预算。"
  }
 ],
 "s8": [
  {
   "start": 0.1,
   "end": 1.263,
   "text": "分工三个人。"
  },
  {
   "start": 1.213,
   "end": 4.953,
   "text": "A 负责程序：架构、六个模块的交互、判分和难度。"
  },
  {
   "start": 4.953,
   "end": 9.067,
   "text": "B 负责视觉：品牌、色彩、场景和深色主题。"
  },
  {
   "start": 9.067,
   "end": 13.237,
   "text": "C 负责内容：词库分级、题目、对比卡和校验。"
  }
 ],
 "s9": [
  {
   "start": 0.1,
   "end": 3.753,
   "text": "微光港，一个不用注册、断网也能用的英语练习站。"
  },
  {
   "start": 3.703,
   "end": 6.231,
   "text": "网址和离线包都在提交材料里。"
  }
 ]
}